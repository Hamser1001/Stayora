# Where the browser sends API calls.
# In development the Vite server proxies "/api" to http://localhost:4000.
# In production point this at the deployed API, e.g. https://api.example.com/api
VITE_API_URL=/api

# The CMS site slug used for public availability and bookings.
# This must match a site in the dashboard CMS (Site settings → slug).
VITE_SITE_SLUG=brothers-surf-camp

# Public origin of the website, used for canonical links, Open Graph and JSON-LD.
VITE_SITE_URL=http://localhost:5174
